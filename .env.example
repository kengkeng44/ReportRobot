# ========================================
# ReportRobot 環境變數範本
# 複製成 .env 後填入真實值。Railway 部署用 Infisical sync。
# 詳細說明見 README.md「環境變數」段。
# ========================================

# ===== LINE Messaging API =====
LINE_CHANNEL_TOKEN=
LINE_CHANNEL_SECRET=
LINE_GROUP_ID=                          # 每日推播目標群組(C 開頭 33 字元)

# ===== Gmail / 對帳單(OAuth2)=====
GMAIL_USER=                             # 帳號 email
TOKEN_PICKLE_B64=                       # OAuth token base64(雲端必填)
PDF_PASSWORD_PREFIX=                    # 富邦對帳單 PDF 解密密碼前 4 碼

# ===== 外部 API =====
ANTHROPIC_API_KEY=                      # Claude API
CWA_API_KEY=                            # 中央氣象署 opendata.cwa.gov.tw
OWM_API_KEY=                            # OpenWeatherMap

# ===== Notion 持久化(待辦/提醒/LINE 配額)=====
# 1. https://www.notion.so/my-integrations 建 internal integration 拿 token
# 2. 在 Notion 父頁面 Share → Connect to → 選此 integration(否則 API 會 forbidden)
NOTION_TOKEN=                           # secret_xxx 開頭
NOTION_PARENT_PAGE_ID=                  # 父頁面 32 字元 ID(可帶 - 或不帶)

# ===== Admin =====
ADMIN_TOKEN=                            # /admin/* endpoint 保護用
ADMIN_LINE_USER_ID=                     # 你的 LINE userId,LINE 群組打 /我的id 取得

# ===== 設定 =====
WEATHER_LOCATIONS=淡水區,金山區          # 群組版天氣地點(逗號分隔)
PERSONAL_WEATHER_LOCATIONS=板橋區        # 個人版天氣地點,沒設就是板橋區
MANUAL_STOCKS=                          # 預留:手動追蹤股票清單(逗號分隔)
MANUAL_PRICES=                          # 手動覆寫特殊代號現價,KEY=VALUE,KEY=VALUE
GOLD_GRAM_PER_SHARE=3.75                # 黃金存摺每張幾克(3.75=1錢 / 37.5=1兩)
DAILY_CRON=0 22 * * *                   # 排程 cron(預設 UTC 22:00 = 台北 06:00)
LINE_PUSH_QUOTA=200                     # LINE 月 push 配額(輕用量=200 / 中=3000 / 高=6000)
GMAIL_FORWARD_FROM=                     # 重要 Gmail 即時轉發寄件人 watchlist(逗號分隔)

# ===== 系統 =====
TZ=Asia/Taipei
PYTHONUNBUFFERED=1                      # 讓 print 即時顯示在 Railway log
